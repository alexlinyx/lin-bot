# Copy to .env and fill in real values. The real .env is git-ignored.
# The app validates this at startup and refuses to boot if something required is missing.

# Which provider answers requests: fake | deepseek | hf | anthropic
PROVIDER=deepseek

# Auth for the DeepSeek hosted API (required when PROVIDER or FALLBACK_PROVIDER is deepseek)
DEEPSEEK_API_KEY=sk-your-key-here

# Model/version to call on the primary provider
MODEL_NAME=deepseek-chat

# Self-hosted fine-tuned model on HF Inference Endpoints (Phase 2+)
# HF_ENDPOINT_URL=https://your-endpoint.endpoints.huggingface.cloud
# HF_TOKEN=hf_your-token-here
# HF_MODEL_NAME=linbot-v1

# Anthropic Claude (required when PROVIDER/CANARY_PROVIDER/FALLBACK_PROVIDER is anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL_NAME=claude-opus-4-8

# Canary rollout (Phase 2+): share of traffic (0-100) sent to CANARY_PROVIDER
CANARY_PERCENT=0
# CANARY_PROVIDER=hf

# Known-good provider requests fall back to when the chosen one fails
# FALLBACK_PROVIDER=deepseek

# Postgres connection string. Railway/Heroku-style postgres:// URLs are normalized automatically.
DATABASE_URL=postgresql://linbot:linbot@localhost:5432/linbot

# Max requests per client per window
RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60

# HTTP
PORT=8000
